# ==============================================================================
# STREAMIFY ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEVELOPMENT (Local CloudWeave Object Storage + Local Docker DB/Redis)
# ------------------------------------------------------------------------------
PORT=8080
DATABASE_URL="postgres://postgres:postgres@localhost:5432/streamify?sslmode=disable"
REDIS_ADDR="127.0.0.1:6379"

# S3 Configuration for Local CloudWeave
S3_ENDPOINT="127.0.0.1:9000"
S3_ACCESS_KEY="master-secret-key"
S3_SECRET_KEY="master-secret-key"
S3_REGION="us-east-1"
S3_USE_SSL="false"
S3_RAW_BUCKET="raw-uploads"
S3_HLS_BUCKET="hls-streams"

# Frontend Environment Variable
NEXT_PUBLIC_API_URL="http://localhost:8080/api"

# ------------------------------------------------------------------------------
# 2. PRODUCTION (Neon Postgres + Neon Object Storage)
# ------------------------------------------------------------------------------
# When deploying to production, simply replace the variables above with your Neon credentials:
#
# DATABASE_URL="postgres://<user>:<password>@<neon-subdomain>.neon.tech/streamify?sslmode=require"
# REDIS_ADDR="<upstash-or-managed-redis-url>"
#
# S3_ENDPOINT="<neon-branch-storage-endpoint>" # e.g. s3.aws-us-east-2.neon.tech
# S3_ACCESS_KEY="<neon-s3-access-key>"
# S3_SECRET_KEY="<neon-s3-secret-key>"
# S3_REGION="aws-us-east-2"
# S3_USE_SSL="true"
# S3_RAW_BUCKET="raw-uploads"
# S3_HLS_BUCKET="hls-streams"
#
# NEXT_PUBLIC_API_URL="https://your-api-domain.com/api"
