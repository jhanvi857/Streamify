# ==============================================================================
# STREAMIFY ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: LOCAL DEV (Docker: PostgreSQL + Redis + CloudWeave)
# Run: docker compose up -d
# ------------------------------------------------------------------------------
PORT=8080
DATABASE_URL="postgres://postgres:postgres@localhost:5432/streamify?sslmode=disable"
REDIS_ADDR="127.0.0.1:6379"

# S3 Configuration for Local CloudWeave Object Storage
S3_ENDPOINT="127.0.0.1:9000"
S3_ACCESS_KEY="master-secret-key"
S3_SECRET_KEY="master-secret-key"
S3_REGION="us-east-1"
S3_USE_SSL="false"
S3_RAW_BUCKET="raw-uploads"
S3_HLS_BUCKET="hls-streams"

# Frontend & Auth
NEXT_PUBLIC_API_URL="http://localhost:8080/api"
BETTER_AUTH_SECRET="streamify-dev-secret-key-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# OPTION B: PRODUCTION / CLOUD (Neon PostgreSQL + Neon Storage + Upstash Redis)
# Run: neon deploy
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://<user>:<password>@ep-xxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@ep-xxx.c-3.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# NEON_BRANCH="production"
# REDIS_ADDR="rediss://default:<password>@<endpoint>.upstash.io:6379"
#
# # Neon Object Storage (pulled automatically by 'neon deploy')
# AWS_ENDPOINT_URL_S3="https://<branch>.storage.c-3.<region>.aws.neon.tech"
# AWS_ACCESS_KEY_ID="nak_live_xxx"
# AWS_SECRET_ACCESS_KEY="nsk_live_xxx"
# AWS_REGION="ap-southeast-1"
#
# S3_ENDPOINT="<branch>.storage.c-3.<region>.aws.neon.tech"
# S3_ACCESS_KEY="nak_live_xxx"
